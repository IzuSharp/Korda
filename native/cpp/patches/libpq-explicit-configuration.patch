 #ifndef LIBPQ_INT_H
 #define LIBPQ_INT_H
+
+/* NativeWeave DB-CPP-01 compatibility: its explicit typed configuration
+ * rejects the original thirteen PG overrides before libpq is called. SQLx
+ * ignored all other PG environment defaults; libpq must ignore them too.
+ * No process environment is mutated, including during concurrent connects.
+ */
+static inline char *
+nw_libpq_getenv(const char *name)
+{
+    return strncmp(name, "PG", 2) == 0 ? NULL : getenv(name);
+}
 
