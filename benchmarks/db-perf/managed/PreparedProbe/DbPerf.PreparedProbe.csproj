<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net11.0</TargetFramework><LangVersion>15.0</LangVersion>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><PublishAot>true</PublishAot><IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <UseSharedCompilation>false</UseSharedCompilation><EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <AssemblyName>DbPerf.PreparedProbe</AssemblyName>
    <Provider Condition="'$(Provider)' == ''">Sqlite</Provider>
    <DefineConstants Condition="'$(Provider)' == 'PostgreSql'">$(DefineConstants);POSTGRES</DefineConstants>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Korda.Database.$(Provider)" Version="$(KordaVersion)" /></ItemGroup>
</Project>
