<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>NativeWeave.Server.Streaming.Tests</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ApiCheck/**/*.cs" />
    <Compile Include="../../src/Server.Streaming/*.cs" />
    <Compile Include="../../samples/api/server-streaming/StreamingExamples.cs" />
    <ProjectReference Include="../../src/NativeWeave.Core/NativeWeave.Core.csproj" />
  </ItemGroup>
</Project>
