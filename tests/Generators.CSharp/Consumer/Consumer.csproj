<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><AssemblyName>NativeWeave.Generators.CSharp.Consumer</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GeneratedBindings Condition="'$(GeneratedBindings)' == ''">$(MSBuildProjectDirectory)/generated</GeneratedBindings>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;CoordinatorFixture.cs" />
    <Compile Include="$(GeneratedBindings)/Bindings.g.cs" Link="Bindings.g.cs" />
    <AdditionalFiles Include="$(GeneratedBindings)/Bindings.nwmetadata" />
    <Analyzer Include="$(NativeWeaveA12AnalyzerPath)" Condition="'$(NativeWeaveA12AnalyzerPath)' != ''" />
    <ProjectReference Include="../../../src/NativeWeave.Core/NativeWeave.Core.csproj" />
    <ProjectReference Include="../../../src/Generators.CSharp/Metadata/NativeWeave.Generators.CSharp.Metadata.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;RuntimeIdentifiers;SelfContained" />
  </ItemGroup>
</Project>
