<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>NativeWeave.Server.Application.Tests</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ApiCheck/**/*.cs" />
    <ProjectReference Include="../../src/Server.Application/NativeWeave.Server.csproj" />
    <ProjectReference Include="../../src/Server.Application/Hosting/NativeWeave.Server.Hosting.csproj" />
    <ProjectReference Include="../../src/Server.Application/Generator/NativeWeave.Server.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
