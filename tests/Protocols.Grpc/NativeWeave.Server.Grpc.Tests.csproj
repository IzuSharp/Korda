<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>NativeWeave.Server.Grpc.Tests</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Protocols.Grpc/NativeWeave.Server.Grpc.csproj" />
    <PackageReference Include="Google.Protobuf" Version="[3.36.2]" />
    <PackageReference Include="Grpc.Net.Client" Version="[2.85.0]" />
    <PackageReference Include="Grpc.Tools" Version="[2.85.0]" PrivateAssets="All" />
    <Protobuf Include="messages.proto" GrpcServices="None" />
    <Compile Remove="ApiCheck/**/*.cs" />
  </ItemGroup>
</Project>
