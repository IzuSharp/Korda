<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Korda.Data.Materialization.Tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;ShapeOracle.cs;CountedTransport.cs;GeneratedOracle.cs" />
    <Compile Include="../../samples/api/data-materialization/Examples.cs" Link="Examples.cs" />
    <ProjectReference Include="../../src/Data.Sqlite/Korda.Database.Sqlite.csproj" />
    <ProjectReference Include="../../src/Data.Postgres/Korda.Database.PostgreSql.csproj" />
    <ProjectReference Include="../../src/Query.Generator/Korda.Query.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
