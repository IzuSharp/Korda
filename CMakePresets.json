{
  "version": 10,
  "cmakeMinimumRequired": { "major": 4, "minor": 3, "patch": 3 },
  "configurePresets": [
    {
      "name": "native-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_STANDARD": "17",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "NW_LLVM_VERSION": "23.1.5"
      }
    },
    {
      "name": "linux-x64-release",
      "inherits": "native-base",
      "binaryDir": "${sourceDir}/artifacts/cmake/linux-x64-release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/artifacts/native-install/linux-x64-release"
      }
    },
    {
      "name": "linux-x64-asan-ubsan",
      "inherits": "linux-x64-release",
      "binaryDir": "${sourceDir}/artifacts/cmake/linux-x64-asan-ubsan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "NW_SANITIZERS": true }
    },
    {
      "name": "windows-x64-release",
      "inherits": "native-base",
      "binaryDir": "${sourceDir}/artifacts/cmake/windows-x64-release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_C_COMPILER": "clang-cl", "CMAKE_CXX_COMPILER": "clang-cl", "CMAKE_BUILD_TYPE": "Release", "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL" }
    },
    {
      "name": "macos-release",
      "inherits": "native-base",
      "binaryDir": "${sourceDir}/artifacts/cmake/macos-release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++", "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "linux-x64-release", "configurePreset": "linux-x64-release" },
    { "name": "linux-x64-asan-ubsan", "configurePreset": "linux-x64-asan-ubsan" },
    { "name": "windows-x64-release", "configurePreset": "windows-x64-release" },
    { "name": "macos-release", "configurePreset": "macos-release" }
  ],
  "testPresets": [
    { "name": "linux-x64-release", "configurePreset": "linux-x64-release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "linux-x64-asan-ubsan", "configurePreset": "linux-x64-asan-ubsan", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" }, "environment": { "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1", "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1" } }
  ]
}
