<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net11.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <NativeWeavePackageVersion Condition="'$(NativeWeavePackageVersion)' == ''">0.1.0-preview.1</NativeWeavePackageVersion>
    <NativeWeaveExcludeGenerators Condition="'$(ManualMappings)' == 'true'">true</NativeWeaveExcludeGenerators>
    <DefineConstants Condition="'$(ManualMappings)' == 'true'">$(DefineConstants);MANUAL_MAPPING</DefineConstants>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="NativeWeave.Database.Sqlite" Version="$(NativeWeavePackageVersion)" /></ItemGroup>
</Project>
