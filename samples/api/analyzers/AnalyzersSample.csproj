<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>NativeWeave.Analyzers.Sample</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <NativeWeaveAnalyzeAll>true</NativeWeaveAnalyzeAll>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
    <DefineConstants Condition="'$(NativeWeaveAotNegative)' == 'true'">$(DefineConstants);AOT_NEGATIVE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(NativeWeaveAnalyzerPackageVersion)' == ''">
    <ProjectReference Include="../../../src/Analyzers/NativeWeave.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;RuntimeIdentifiers;SelfContained;NuGetLockFilePath" />
    <CompilerVisibleProperty Include="NativeWeaveAnalyzeAll" />
  </ItemGroup>
  <ItemGroup Condition="'$(NativeWeaveAnalyzerPackageVersion)' != ''">
    <PackageReference Include="NativeWeave.Analyzers" Version="$(NativeWeaveAnalyzerPackageVersion)" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(NativeWeaveNativeLibrary)' != ''">
    <None Include="$(NativeWeaveNativeLibrary)" Link="libnativeweave_hello.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
