using NativeWeave.Interop;
using NativeWeave.Interop.Extensibility;

namespace NativeWeave.Conformance.Packaging;

/// <summary>A local package-composition facade over the implemented Core loader.</summary>
/// <remarks>This sample is not a database or server product. The static descriptor loads no native code until Inspect; the module remains resident until process exit.</remarks>
public static class PackagingEngine
{
    /// <summary>Gets the precompiled descriptor of the selected, immutable sample package.</summary>
    /// <remarks>Construction allocates bounded metadata once. Inspect validates native content and calls the actual Core ABI bootstrap before publishing EngineInfo.</remarks>
    public static EngineDescriptor Descriptor { get; } = EnginePackage.CreateDescriptor(
        new EnginePackageManifest("conformance.packaging", "NativeWeave.Conformance.Packaging", "@VERSION@",
            new AbiVersion(1, 0), "nw_packaging_get_abi_v1", EngineThreadingModel.Synchronous,
            [new NativeAssetDescriptor("linux-x64", "runtimes/linux-x64/native/libnw_packaging.so", "@NATIVE_SHA@", "x86-64-v2")],
            [new(new EngineCapability("buffer.owned"), 0)]), typeof(PackagingEngine).Assembly);
}
