using System.Runtime.CompilerServices;
using NativeWeave.Conformance.Packaging;
using NativeWeave.Interop;
using NativeWeave.Generated.Conformance;

if (args.Contains("--require-aot") && RuntimeFeature.IsDynamicCodeSupported)
    throw new InvalidOperationException("Actual Native AOT execution is required.");
if (args.Contains("--missing-capability"))
{
    try
    {
        PackagingEngine.Descriptor.Inspect(new EngineLoadOptions { RequiredCapabilities = [new("absent.feature")] });
        throw new InvalidOperationException("Missing native capability was accepted.");
    }
    catch (EngineLoadException error) when (error.Failure == EngineLoadFailure.MissingCapability)
    {
        Console.WriteLine("PASS explicit missing capability diagnostic; no native rebuild.");
        return;
    }
}
EngineInfo engine = PackagingEngine.Descriptor.Inspect();
if (engine.EngineId != "conformance.packaging" || engine.AbiVersion != new AbiVersion(1, 0)
    || !engine.Supports(new EngineCapability("buffer.owned")))
    throw new InvalidOperationException("Native package bootstrap differs from its descriptor.");
if (@METADATA_TYPE@.ExportCount != 0)
    throw new InvalidOperationException("Transitive metadata generator did not produce the expected static binding.");
var entity = new Entity(42, "typed C#");
Dto dto = Handler(entity);
if (dto.Value != "typed C#:42") throw new InvalidOperationException("Typed handler result mismatch.");
Console.WriteLine($"PASS independent package {engine.PackageVersion}; dynamicCode={RuntimeFeature.IsDynamicCodeSupported}; {dto.Value}");

static Dto Handler(Entity entity) => new($"{entity.Name}:{entity.Id}");
internal sealed record Entity(int Id, string Name);
internal sealed record Dto(string Value);
