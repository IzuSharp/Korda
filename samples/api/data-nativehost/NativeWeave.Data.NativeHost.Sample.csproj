<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>NativeWeave.Data.NativeHost.Sample</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Data.Sqlite/NativeWeave.Database.Sqlite.csproj" />
    <ProjectReference Include="../../../src/Data.Postgres/NativeWeave.Database.PostgreSql.csproj" />
  </ItemGroup>
</Project>
