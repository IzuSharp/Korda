<Project>
  <PropertyGroup>
    <NativeWeaveAnalyzerPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/netstandard2.0/NativeWeave.Analyzers.dll'))</NativeWeaveAnalyzerPath>
  </PropertyGroup>
  <ItemGroup>
    <Analyzer Remove="$(NativeWeaveAnalyzerPath)" />
    <Analyzer Include="$(NativeWeaveAnalyzerPath)" />
    <CompilerVisibleProperty Include="NativeWeaveAnalyzeAll" />
    <CompilerVisibleProperty Include="NativeWeaveRequireBindingMetadata" />
    <CompilerVisibleProperty Include="NativeWeaveCheckPublicDocumentation" />
    <CompilerVisibleProperty Include="NativeWeaveRequireApiBaseline" />
  </ItemGroup>
</Project>
