<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>NativeWeave.Analyzers</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>true</IsPackable>
    <PackageId>NativeWeave.Analyzers</PackageId>
    <Description>Build-time NativeWeave ABI, ownership, AOT and API diagnostics.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" PrivateAssets="all" />
    <InternalsVisibleTo Include="NativeWeave.Analyzers.Tests" />
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="tools/netstandard2.0/" Visible="false" />
    <None Include="$(OutputPath)$(AssemblyName).xml" Pack="true" PackagePath="tools/netstandard2.0/" Visible="false" />
    <None Include="buildTransitive/NativeWeave.Analyzers.targets" Pack="true" PackagePath="buildTransitive/" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
</Project>
