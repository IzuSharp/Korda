<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NativeWeave.Server</AssemblyName>
    <RootNamespace>NativeWeave.Server</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <NativeWeaveServerRuntimeIdentifier Condition="'$(NativeWeaveServerRuntimeIdentifier)' == ''">linux-x64</NativeWeaveServerRuntimeIdentifier>
    <NativeWeaveServerAssetName Condition="'$(NativeWeaveServerAssetName)' == ''">libnativeweave_server.so</NativeWeaveServerAssetName>
    <NativeWeaveServerAssetPath Condition="'$(NativeWeaveServerAssetPath)' == ''">$(MSBuildThisFileDirectory)../../target/release/$(NativeWeaveServerAssetName)</NativeWeaveServerAssetPath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Generator/**/*.cs;Hosting/**/*.cs" />
    <ProjectReference Include="../NativeWeave.Core/NativeWeave.Core.csproj" />
    <ProjectReference Include="Generator/NativeWeave.Server.Generator.csproj" ReferenceOutputAssembly="false" />
    <EmbeddedResource Include="$(IntermediateOutputPath)native-sha256.txt" LogicalName="NativeWeave.Server.native-sha256" />
    <None Include="$(NativeWeaveServerAssetPath)" Link="runtimes/$(NativeWeaveServerRuntimeIdentifier)/native/$(NativeWeaveServerAssetName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/$(NativeWeaveServerRuntimeIdentifier)/native/" />
    <None Include="$(IntermediateOutputPath)NativeWeave.server.assets.json" Link="NativeWeave.server.assets.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <Compile Include="../Server.Streaming/**/*.cs" Exclude="../Server.Streaming/**/obj/**/*.cs;../Server.Streaming/**/bin/**/*.cs" />
    <Compile Include="../Server.Native/**/*.cs" Exclude="../Server.Native/**/obj/**/*.cs;../Server.Native/**/bin/**/*.cs" />
    <InternalsVisibleTo Include="NativeWeave.Server.Application.Tests" />
    <InternalsVisibleTo Include="NativeWeave.Server.Native.Tests" />
    <InternalsVisibleTo Include="NativeWeave.Server.Streaming.Tests" />
    <InternalsVisibleTo Include="NativeWeave.Server.Hosting" />
    <InternalsVisibleTo Include="NativeWeave.Server.Grpc" />
    <InternalsVisibleTo Include="NativeWeave.Server.Mcp" />
    <InternalsVisibleTo Include="NativeWeave.Server.Diagnostics" />
  </ItemGroup>
  <Target Name="GenerateServerNativeIdentity" BeforeTargets="PrepareResources;CoreCompile">
    <Error Condition="!Exists('$(NativeWeaveServerAssetPath)')" Text="Build the maintainer Rust Server Host first or supply NativeWeaveServerAssetPath. Consumer builds never invoke Cargo." />
    <GetFileHash Files="$(NativeWeaveServerAssetPath)" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="_ServerNativeHash" /></GetFileHash>
    <PropertyGroup><_ServerHash>@(_ServerNativeHash-&gt;'%(FileHash)')</_ServerHash><_ServerLowerHash>$(_ServerHash.ToLowerInvariant())</_ServerLowerHash></PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)native-sha256.txt" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="$(_ServerLowerHash)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)NativeWeave.server.assets.json" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="{ &quot;schemaVersion&quot;: 1, &quot;engineId&quot;: &quot;server&quot;, &quot;packageId&quot;: &quot;NativeWeave.Server&quot;, &quot;packageVersion&quot;: &quot;$(Version)&quot;, &quot;rid&quot;: &quot;$(NativeWeaveServerRuntimeIdentifier)&quot;, &quot;sourcePath&quot;: &quot;runtimes/$(NativeWeaveServerRuntimeIdentifier)/native/$(NativeWeaveServerAssetName)&quot;, &quot;outputPath&quot;: &quot;runtimes/$(NativeWeaveServerRuntimeIdentifier)/native/$(NativeWeaveServerAssetName)&quot;, &quot;sha256&quot;: &quot;$(_ServerLowerHash)&quot; }" />
  </Target>
</Project>
