<Project>
  <!-- Explicit maintainer target only. There is no BeforeTargets/AfterTargets or
       dependency from Build/Restore/Publish, and this file is not a NuGet asset. -->
  <PropertyGroup>
    <NativeWeaveBuildRoot Condition="'$(NativeWeaveBuildRoot)' == ''">$(MSBuildThisFileDirectory)../..</NativeWeaveBuildRoot>
    <NativeWeavePython Condition="'$(NativeWeavePython)' == ''">python3</NativeWeavePython>
  </PropertyGroup>
  <Target Name="NativeWeaveBuildNative">
    <Error Condition="'$(NativeWeaveMaintainerBuild)' != 'true'"
           Text="NativeWeaveBuildNative is an explicit maintainer operation. Set NativeWeaveMaintainerBuild=true and supply the reviewed NativeWeaveBuildProfile." />
    <Error Condition="'$(NativeWeaveBuildProfile)' == ''"
           Text="A reviewed native build profile is required." />
    <PropertyGroup>
      <_NativeWeaveProfile>$([System.IO.Path]::GetFullPath('$(NativeWeaveBuildProfile)', '$(NativeWeaveBuildRoot)'))</_NativeWeaveProfile>
    </PropertyGroup>
    <Error Condition="!Exists('$(_NativeWeaveProfile)')" Text="A reviewed native build profile is required." />
    <Exec WorkingDirectory="$(NativeWeaveBuildRoot)"
          Command="&quot;$(NativeWeavePython)&quot; &quot;$(MSBuildThisFileDirectory)build_native.py&quot; build --root &quot;$(NativeWeaveBuildRoot)&quot; --profile &quot;$(_NativeWeaveProfile)&quot;" />
  </Target>
</Project>
