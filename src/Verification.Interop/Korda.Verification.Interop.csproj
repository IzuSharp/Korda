<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Korda.Verification.Interop</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Korda.Core/Korda.Core.csproj" />
    <InternalsVisibleTo Include="Korda.Verification.Interop.Tests" />
    <InternalsVisibleTo Include="Korda.Verification.Interop.Sample" />
    <None Include="../../artifacts/a20-native/linux-x64/*.so" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireA20Native" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../../artifacts/a20-native/linux-x64/libkorda_verification_interop.so')" Text="Run the maintainer A20 verifier --prepare-native once before ordinary dotnet build/run; no consumer native compiler target is installed." />
  </Target>
</Project>
