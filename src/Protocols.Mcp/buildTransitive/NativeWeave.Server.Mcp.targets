<Project>
  <!-- The static layout proof needs complete private instance fields from
       ProjectReference implementations, which reference assemblies omit.
       This is the SDK's supported compiler-input choice; it invokes no Rust. -->
  <PropertyGroup>
    <CompileUsingReferenceAssemblies>false</CompileUsingReferenceAssemblies>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)../nativeweave/NativeWeave.Mcp.Packaging.targets"
          Condition="Exists('$(MSBuildThisFileDirectory)../nativeweave/NativeWeave.Mcp.Packaging.targets')" />
</Project>
