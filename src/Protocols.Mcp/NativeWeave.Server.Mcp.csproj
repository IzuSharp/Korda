<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NativeWeave.Server.Mcp</AssemblyName>
    <RootNamespace>NativeWeave.Server.Mcp</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Generator/**/*.cs" />
    <ProjectReference Include="../Server.Application/NativeWeave.Server.csproj" />
    <ProjectReference Include="Generator/NativeWeave.Server.Mcp.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="Generator/bin/$(Configuration)/netstandard2.0/NativeWeave.Server.Mcp.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
    <None Include="buildTransitive/NativeWeave.Server.Mcp.targets" Pack="true" PackagePath="buildTransitive/" />
    <InternalsVisibleTo Include="NativeWeave.Server.Mcp.Tests" />
  </ItemGroup>
</Project>
