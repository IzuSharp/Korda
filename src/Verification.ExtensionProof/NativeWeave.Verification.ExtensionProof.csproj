<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NativeWeave.Verification.ExtensionProof</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile><IsPackable>false</IsPackable>
    <NativeAssetPath Condition="'$(NativeAssetPath)' == ''">$(MSBuildThisFileDirectory)../../target/release/libnativeweave_engine_extensionproof.so</NativeAssetPath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NativeWeave.Core/NativeWeave.Core.csproj" />
    <InternalsVisibleTo Include="NativeWeave.Verification.ExtensionProof.Tests" />
    <InternalsVisibleTo Include="NativeWeave.Verification.ExtensionProof.Sample" />
    <None Include="$(NativeAssetPath)" Link="runtimes/linux-x64/native/libnativeweave_engine_extensionproof.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(IntermediateOutputPath)NativeWeave.nativeweave.verification.extensionproof.assets.json" Link="NativeWeave.nativeweave.verification.extensionproof.assets.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ReadPrebuiltExtensionIdentity" BeforeTargets="AssignTargetPaths">
    <Error Condition="!Exists('$(NativeAssetPath)')" Text="Maintainers must build the extension-proof native asset before this internal conformance assembly." />
    <GetFileHash Files="$(NativeAssetPath)" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="_ExtensionIdentity" /></GetFileHash>
    <PropertyGroup><_ExtensionHash>@(_ExtensionIdentity->'%(FileHash)')</_ExtensionHash><_ExtensionLowerHash>$(_ExtensionHash.ToLowerInvariant())</_ExtensionLowerHash></PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)extension-native.sha256" Lines="%(_ExtensionIdentity.FileHash)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(IntermediateOutputPath)NativeWeave.nativeweave.verification.extensionproof.assets.json" Lines="{ &quot;schemaVersion&quot;: 1, &quot;engineId&quot;: &quot;nativeweave.verification.extensionproof&quot;, &quot;packageId&quot;: &quot;NativeWeave.Verification.ExtensionProof&quot;, &quot;packageVersion&quot;: &quot;0.1.0-proof.1&quot;, &quot;rid&quot;: &quot;linux-x64&quot;, &quot;sourcePath&quot;: &quot;runtimes/linux-x64/native/libnativeweave_engine_extensionproof.so&quot;, &quot;outputPath&quot;: &quot;runtimes/linux-x64/native/libnativeweave_engine_extensionproof.so&quot;, &quot;sha256&quot;: &quot;$(_ExtensionLowerHash)&quot; }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><EmbeddedResource Include="$(IntermediateOutputPath)extension-native.sha256" LogicalName="NativeWeave.Verification.ExtensionProof.native-sha256" /></ItemGroup>
  </Target>
</Project>
