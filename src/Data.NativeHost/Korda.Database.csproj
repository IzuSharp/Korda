<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Korda.Database</AssemblyName>
    <RootNamespace>Korda.Database</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>Korda.Database</PackageId>
    <Description>Typed application facade over independently packaged Korda C++ database engines.</Description>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Korda.Core/Korda.Core.csproj" />
    <ProjectReference Include="../Data.Abstractions/Korda.Data.csproj" />
    <ProjectReference Include="../Data.Transactions/Korda.Database.Transactions.csproj" />
    <ProjectReference Include="../Data.Streaming/Korda.Data.Streaming.csproj" />
    <ProjectReference Include="../Query.Binding/Korda.Query.Binding.csproj" />
    <Compile Remove="Providers/**/*.cs;DependencyInjection/**/*.cs" />
    <Compile Include="../Query.Native/**/*.cs;../Query.Fluent/**/*.cs;../Orm.Relations/**/*.cs;../Data.Migrations/**/*.cs;../Data.Materialization/**/*.cs" Exclude="../**/obj/**/*.cs;../**/bin/**/*.cs;../Orm.Relations/ConcurrencyConflictException.cs" />
    <InternalsVisibleTo Include="Korda.Database.Sqlite" />
    <InternalsVisibleTo Include="Korda.Database.PostgreSql" />
    <InternalsVisibleTo Include="Korda.Data.NativeHost.Tests" />
    <InternalsVisibleTo Include="Korda.Query.Native.Tests" />
    <InternalsVisibleTo Include="Korda.Query.Fluent.Tests" />
    <InternalsVisibleTo Include="Korda.Orm.Relations.Tests" />
    <InternalsVisibleTo Include="Korda.Data.Migrations.Tests" />
    <InternalsVisibleTo Include="Korda.Data.Materialization.Tests" />
  </ItemGroup>
</Project>
