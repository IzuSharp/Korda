<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NativeWeave.Data</AssemblyName>
    <RootNamespace>NativeWeave.Data</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
    <IsPackable>true</IsPackable>
    <PackageId>NativeWeave.Data</PackageId>
    <Description>Strongly typed NativeWeave data descriptors and shared wire contracts. No database runtime is loaded.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NativeWeave.Data.Tests" />
    <InternalsVisibleTo Include="NativeWeave.Database" />
    <InternalsVisibleTo Include="NativeWeave.Data.Streaming" />
    <InternalsVisibleTo Include="NativeWeave.Data.Streaming.Tests" />
    <InternalsVisibleTo Include="NativeWeave.Data.Streaming.Sample" />
    <InternalsVisibleTo Include="NativeWeave.Database.PostgreSql" />
    <InternalsVisibleTo Include="NativeWeave.Database.Sqlite" />
    <InternalsVisibleTo Include="NativeWeave.Data.Codecs" />
    <InternalsVisibleTo Include="NativeWeave.Data.Codecs.Tests" />
    <InternalsVisibleTo Include="NativeWeave.Query.Binding" />
    <InternalsVisibleTo Include="NativeWeave.Query.Binding.Tests" />
    <InternalsVisibleTo Include="NativeWeave.Query.Binding.Sample" />
    <InternalsVisibleTo Include="NativeWeave.Query.Native.Tests" />
    <InternalsVisibleTo Include="NativeWeave.Data.Materialization.Tests" />
  </ItemGroup>
</Project>
