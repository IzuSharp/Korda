<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;PublishTrimmed;RuntimeIdentifier;RuntimeIdentifiers;SelfContained">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Compiler plugins execute in the managed compiler host, including during consumer AOT builds. -->
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <RuntimeIdentifier></RuntimeIdentifier>
    <RuntimeIdentifiers></RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <AssemblyName>NativeWeave.Generators.CSharp.Metadata</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>true</IsPackable>
    <PackageId>NativeWeave.Generators.CSharp.Metadata</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" PrivateAssets="all" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md;AnalyzerReleases.Unshipped.md" />
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="tools/roslyn/" Visible="false" />
    <None Include="buildTransitive/NativeWeave.Generators.CSharp.Metadata.targets" Pack="true" PackagePath="buildTransitive/" />
    <InternalsVisibleTo Include="NativeWeave.Generators.CSharp.Tests" />
  </ItemGroup>
</Project>
