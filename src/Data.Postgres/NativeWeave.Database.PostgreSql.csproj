<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <AssemblyName>NativeWeave.Database.PostgreSql</AssemblyName>
    <RootNamespace>NativeWeave.Database.PostgreSql</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <NativeWeavePostgresRuntimeIdentifier Condition="'$(NativeWeavePostgresRuntimeIdentifier)' == ''">linux-x64</NativeWeavePostgresRuntimeIdentifier>
    <NativeWeavePostgresAssetName Condition="'$(NativeWeavePostgresAssetName)' == ''">libnw_database_postgresql.so</NativeWeavePostgresAssetName>
    <NativeWeavePostgresAssetPath Condition="'$(NativeWeavePostgresAssetPath)' == ''">$(MSBuildThisFileDirectory)../../target/release/$(NativeWeavePostgresAssetName)</NativeWeavePostgresAssetPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Query.Generator/NativeWeave.Query.Generator.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="$(IntermediateOutputPath)PostgreSqlAssetIdentity.g.cs" />
    <None Include="$(NativeWeavePostgresAssetPath)" Link="runtimes/$(NativeWeavePostgresRuntimeIdentifier)/native/$(NativeWeavePostgresAssetName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="%(Link)" />
    <None Include="$(IntermediateOutputPath)NativeWeave.database.postgresql.assets.json" Link="NativeWeave.database.postgresql.assets.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="%(Link)" />
    <ProjectReference Include="../NativeWeave.Core/NativeWeave.Core.csproj" />
    <ProjectReference Include="../Data.Abstractions/NativeWeave.Data.csproj" />
    <InternalsVisibleTo Include="NativeWeave.Database.PostgreSql.Tests" />
    <InternalsVisibleTo Include="NativeWeave.Database" />
    <ProjectReference Include="../Data.NativeHost/NativeWeave.Database.csproj" />
    <Compile Include="../Data.NativeHost/Providers/PostgreSql/**/*.cs" />
  </ItemGroup>
  <Target Name="GeneratePostgreSqlAssetIdentity" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(NativeWeavePostgresAssetPath)')" Text="Build the maintainer PostgreSQL native Database Host first or supply NativeWeavePostgresAssetPath. Consumer builds never invoke Cargo." />
    <GetFileHash Files="$(NativeWeavePostgresAssetPath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_PostgreSqlNativeHash" />
    </GetFileHash>
    <PropertyGroup>
      <_PostgreSqlHash>@(_PostgreSqlNativeHash->'%(FileHash)')</_PostgreSqlHash>
      <_PostgreSqlLowerHash>$(_PostgreSqlHash.ToLowerInvariant())</_PostgreSqlLowerHash>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)PostgreSqlAssetIdentity.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="namespace NativeWeave.Database.PostgreSql { internal static class PostgreSqlAssetIdentity { internal const string RuntimeIdentifier = &quot;$(NativeWeavePostgresRuntimeIdentifier)&quot;%3B internal const string RelativePath = &quot;runtimes/$(NativeWeavePostgresRuntimeIdentifier)/native/$(NativeWeavePostgresAssetName)&quot;%3B internal const string Sha256 = &quot;$(_PostgreSqlLowerHash)&quot;%3B } }" />
    <WriteLinesToFile File="$(IntermediateOutputPath)NativeWeave.database.postgresql.assets.json" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="{ &quot;schemaVersion&quot;: 1, &quot;engineId&quot;: &quot;database.postgresql&quot;, &quot;packageId&quot;: &quot;NativeWeave.Database.PostgreSql&quot;, &quot;packageVersion&quot;: &quot;$(Version)&quot;, &quot;rid&quot;: &quot;$(NativeWeavePostgresRuntimeIdentifier)&quot;, &quot;sourcePath&quot;: &quot;runtimes/$(NativeWeavePostgresRuntimeIdentifier)/native/$(NativeWeavePostgresAssetName)&quot;, &quot;outputPath&quot;: &quot;runtimes/$(NativeWeavePostgresRuntimeIdentifier)/native/$(NativeWeavePostgresAssetName)&quot;, &quot;sha256&quot;: &quot;$(_PostgreSqlLowerHash)&quot; }" />
  </Target>
</Project>
