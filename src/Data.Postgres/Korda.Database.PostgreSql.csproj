<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <AssemblyName>Korda.Database.PostgreSql</AssemblyName>
    <RootNamespace>Korda.Database.PostgreSql</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <KordaPostgresRuntimeIdentifier Condition="'$(KordaPostgresRuntimeIdentifier)' == ''">linux-x64</KordaPostgresRuntimeIdentifier>
    <KordaPostgresAssetName Condition="'$(KordaPostgresAssetName)' == ''">libnw_database_postgresql.so</KordaPostgresAssetName>
    <KordaPostgresAssetPath Condition="'$(KordaPostgresAssetPath)' == ''">$(MSBuildThisFileDirectory)../../artifacts/native-install/linux-x64-release/lib/$(KordaPostgresAssetName)</KordaPostgresAssetPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Query.Generator/Korda.Query.Generator.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="$(IntermediateOutputPath)PostgreSqlAssetIdentity.g.cs" />
    <None Include="$(KordaPostgresAssetPath)" Link="runtimes/$(KordaPostgresRuntimeIdentifier)/native/$(KordaPostgresAssetName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="%(Link)" />
    <None Include="$(IntermediateOutputPath)Korda.database.postgresql.assets.json" Link="Korda.database.postgresql.assets.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="%(Link)" />
    <ProjectReference Include="../Korda.Core/Korda.Core.csproj" />
    <ProjectReference Include="../Data.Abstractions/Korda.Data.csproj" />
    <InternalsVisibleTo Include="Korda.Database.PostgreSql.Tests" />
    <InternalsVisibleTo Include="Korda.Database" />
    <ProjectReference Include="../Data.NativeHost/Korda.Database.csproj" />
    <Compile Include="../Data.NativeHost/Providers/PostgreSql/**/*.cs" />
  </ItemGroup>
  <Target Name="GeneratePostgreSqlAssetIdentity" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(KordaPostgresAssetPath)')" Text="Build the maintainer PostgreSQL native Database Host first or supply KordaPostgresAssetPath. Consumer builds use precompiled assets and never invoke a native compiler." />
    <GetFileHash Files="$(KordaPostgresAssetPath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_PostgreSqlNativeHash" />
    </GetFileHash>
    <PropertyGroup>
      <_PostgreSqlHash>@(_PostgreSqlNativeHash->'%(FileHash)')</_PostgreSqlHash>
      <_PostgreSqlLowerHash>$(_PostgreSqlHash.ToLowerInvariant())</_PostgreSqlLowerHash>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)PostgreSqlAssetIdentity.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="namespace Korda.Database.PostgreSql { internal static class PostgreSqlAssetIdentity { internal const string RuntimeIdentifier = &quot;$(KordaPostgresRuntimeIdentifier)&quot;%3B internal const string RelativePath = &quot;runtimes/$(KordaPostgresRuntimeIdentifier)/native/$(KordaPostgresAssetName)&quot;%3B internal const string Sha256 = &quot;$(_PostgreSqlLowerHash)&quot;%3B } }" />
    <WriteLinesToFile File="$(IntermediateOutputPath)Korda.database.postgresql.assets.json" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="{ &quot;schemaVersion&quot;: 1, &quot;engineId&quot;: &quot;database.postgresql&quot;, &quot;packageId&quot;: &quot;Korda.Database.PostgreSql&quot;, &quot;packageVersion&quot;: &quot;$(Version)&quot;, &quot;rid&quot;: &quot;$(KordaPostgresRuntimeIdentifier)&quot;, &quot;sourcePath&quot;: &quot;runtimes/$(KordaPostgresRuntimeIdentifier)/native/$(KordaPostgresAssetName)&quot;, &quot;outputPath&quot;: &quot;runtimes/$(KordaPostgresRuntimeIdentifier)/native/$(KordaPostgresAssetName)&quot;, &quot;sha256&quot;: &quot;$(_PostgreSqlLowerHash)&quot; }" />
  </Target>
</Project>
