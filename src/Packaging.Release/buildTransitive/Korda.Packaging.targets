<Project>
  <!-- Included once by each tested facade/native package. These are validation
       and SDK-output records only: no consumer native compilation or restore graph mutation. -->
  <UsingTask TaskName="Korda.Packaging.PackageClosure"
             AssemblyFile="$(MSBuildThisFileDirectory)../tools/net11.0/Korda.Packaging.Tasks.dll" />
  <ItemGroup>
    <KordaClosure Include="$(MSBuildThisFileDirectory)../korda/closure.json" />
  </ItemGroup>
  <Target Name="KordaValidatePackageClosure" BeforeTargets="CoreCompile;PrepareForPublish"
          DependsOnTargets="ResolveReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <PackageClosure ClosureFiles="@(KordaClosure)" AssetsFile="$(ProjectAssetsFile)"
                    RuntimeIdentifier="$(RuntimeIdentifier)"
                    ResolvedFiles="@(NativeCopyLocalItems);@(RuntimeTargetsCopyLocalItems)" />
  </Target>
  <Target Name="KordaWriteBuildAssets" AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PackageClosure ClosureFiles="@(KordaClosure)" AssetsFile="$(ProjectAssetsFile)"
                    RuntimeIdentifier="$(RuntimeIdentifier)" Mode="build" OutputDirectory="$(TargetDir)"
                    ResolvedFiles="@(NativeCopyLocalItems);@(RuntimeTargetsCopyLocalItems)" />
  </Target>
  <Target Name="KordaWritePublishAssets" AfterTargets="ComputeFilesToPublish"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PackageClosure ClosureFiles="@(KordaClosure)" AssetsFile="$(ProjectAssetsFile)"
                    RuntimeIdentifier="$(RuntimeIdentifier)" Mode="publish"
                    OutputDirectory="$(IntermediateOutputPath)korda-publish"
                    ResolvedFiles="@(ResolvedFileToPublish)">
      <Output TaskParameter="Records" ItemName="ResolvedFileToPublish" />
    </PackageClosure>
  </Target>
</Project>
