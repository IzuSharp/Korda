<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NativeWeave.Engines.SyncProof</AssemblyName>
    <RootNamespace>NativeWeave.Engines.SyncProof</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <PackageId>NativeWeave.Engines.SyncProof</PackageId>
    <PackageVersion>0.1.0-proof.1</PackageVersion>
    <Description>Linux synchronous miniz_oxide integration proof; a bounded codec conformance package.</Description>
    <NativeAssetPath Condition="'$(NativeAssetPath)' == ''">$(MSBuildThisFileDirectory)../../target/release/libnativeweave_engine_syncproof.so</NativeAssetPath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NativeWeave.Core/NativeWeave.Core.csproj" />
    <InternalsVisibleTo Include="NativeWeave.Engines.SyncProof.Tests" />
    <None Include="$(NativeAssetPath)" Pack="true" PackagePath="runtimes/linux-x64/native/" Link="runtimes/linux-x64/native/libnativeweave_engine_syncproof.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(IntermediateOutputPath)NativeWeave.nativeweave.engines.syncproof.assets.json" Link="NativeWeave.nativeweave.engines.syncproof.assets.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>
  <Target Name="ReadPrebuiltCodecIdentity" BeforeTargets="AssignTargetPaths">
    <Error Condition="!Exists('$(NativeAssetPath)')" Text="Maintainers must build the pinned sync-proof native asset first. Application consumers use the precompiled NuGet package." />
    <GetFileHash Files="$(NativeAssetPath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_CodecNativeIdentity" />
    </GetFileHash>
    <PropertyGroup><_CodecHash>@(_CodecNativeIdentity->'%(FileHash)')</_CodecHash><_CodecLowerHash>$(_CodecHash.ToLowerInvariant())</_CodecLowerHash></PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)NativeWeave.nativeweave.engines.syncproof.assets.json" Lines="{ &quot;schemaVersion&quot;: 1, &quot;engineId&quot;: &quot;nativeweave.engines.syncproof&quot;, &quot;packageId&quot;: &quot;NativeWeave.Engines.SyncProof&quot;, &quot;packageVersion&quot;: &quot;0.1.0-proof.1&quot;, &quot;rid&quot;: &quot;linux-x64&quot;, &quot;sourcePath&quot;: &quot;runtimes/linux-x64/native/libnativeweave_engine_syncproof.so&quot;, &quot;outputPath&quot;: &quot;runtimes/linux-x64/native/libnativeweave_engine_syncproof.so&quot;, &quot;sha256&quot;: &quot;$(_CodecLowerHash)&quot; }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(IntermediateOutputPath)codec-native.sha256" Lines="%(_CodecNativeIdentity.FileHash)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)codec-native.sha256" LogicalName="NativeWeave.Engines.SyncProof.native-sha256" />
    </ItemGroup>
  </Target>
</Project>
