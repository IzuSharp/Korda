<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <AssemblyName>NativeWeave.Database.Sqlite</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <NativeWeaveSqliteRuntimeIdentifier Condition="'$(NativeWeaveSqliteRuntimeIdentifier)' == ''">linux-x64</NativeWeaveSqliteRuntimeIdentifier>
    <NativeWeaveSqliteAssetName Condition="'$(NativeWeaveSqliteAssetName)' == ''">libnw_database_sqlite.so</NativeWeaveSqliteAssetName>
    <NativeWeaveSqliteAssetPath Condition="'$(NativeWeaveSqliteAssetPath)' == ''">$(MSBuildThisFileDirectory)../../target/release/$(NativeWeaveSqliteAssetName)</NativeWeaveSqliteAssetPath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Query.Generator/NativeWeave.Query.Generator.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Data.Abstractions/NativeWeave.Data.csproj" />
    <ProjectReference Include="../NativeWeave.Core/NativeWeave.Core.csproj" />
    <InternalsVisibleTo Include="NativeWeave.Database" />
    <InternalsVisibleTo Include="NativeWeave.Data.Sqlite.Tests" />
    <Compile Include="$(IntermediateOutputPath)EngineProfile.g.cs" />
    <None Include="$(NativeWeaveSqliteAssetPath)" Link="runtimes/$(NativeWeaveSqliteRuntimeIdentifier)/native/$(NativeWeaveSqliteAssetName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="%(Link)" />
    <None Include="$(IntermediateOutputPath)NativeWeave.database.sqlite.assets.json" Link="NativeWeave.database.sqlite.assets.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="%(Link)" />
    <ProjectReference Include="../Data.NativeHost/NativeWeave.Database.csproj" />
    <Compile Include="../Data.NativeHost/Providers/Sqlite/**/*.cs" />
  </ItemGroup>
  <Target Name="GenerateSqliteEngineProfile" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(NativeWeaveSqliteAssetPath)')" Text="Build the maintainer SQLite native Database Host first or supply NativeWeaveSqliteAssetPath. Consumer builds never invoke Cargo." />
    <GetFileHash Files="$(NativeWeaveSqliteAssetPath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_SqliteNativeHash" />
    </GetFileHash>
    <PropertyGroup>
      <_SqliteHash>@(_SqliteNativeHash->'%(FileHash)')</_SqliteHash>
      <_SqliteLowerHash>$(_SqliteHash.ToLowerInvariant())</_SqliteLowerHash>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)EngineProfile.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="namespace NativeWeave.Database.Sqlite { internal static class GeneratedEngineProfile { internal const string RuntimeIdentifier = &quot;$(NativeWeaveSqliteRuntimeIdentifier)&quot;%3B internal const string RelativePath = &quot;runtimes/$(NativeWeaveSqliteRuntimeIdentifier)/native/$(NativeWeaveSqliteAssetName)&quot;%3B internal const string Sha256 = &quot;%(_SqliteNativeHash.FileHash)&quot;%3B } }" />
    <WriteLinesToFile File="$(IntermediateOutputPath)NativeWeave.database.sqlite.assets.json" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="{ &quot;schemaVersion&quot;: 1, &quot;engineId&quot;: &quot;database.sqlite&quot;, &quot;packageId&quot;: &quot;NativeWeave.Database.Sqlite&quot;, &quot;packageVersion&quot;: &quot;$(Version)&quot;, &quot;rid&quot;: &quot;$(NativeWeaveSqliteRuntimeIdentifier)&quot;, &quot;sourcePath&quot;: &quot;runtimes/$(NativeWeaveSqliteRuntimeIdentifier)/native/$(NativeWeaveSqliteAssetName)&quot;, &quot;outputPath&quot;: &quot;runtimes/$(NativeWeaveSqliteRuntimeIdentifier)/native/$(NativeWeaveSqliteAssetName)&quot;, &quot;sha256&quot;: &quot;$(_SqliteLowerHash)&quot; }" />
  </Target>
</Project>
