<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NativeWeave.Interop.Abi</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NativeWeave.Interop.Abi.Tests" />
    <InternalsVisibleTo Include="NativeWeave.Interop.Abi.Sample" />
    <InternalsVisibleTo Include="NativeWeave.Core" />
    <InternalsVisibleTo Include="NativeWeave.Engines.AsyncProof" />
    <InternalsVisibleTo Include="NativeWeave.Interop.Errors.Tests" />
    <InternalsVisibleTo Include="NativeWeave.Query.Binding" />
    <InternalsVisibleTo Include="NativeWeave.Query.Binding.Tests" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NativeWeave.Interop.Async.Tests" />
    <InternalsVisibleTo Include="NativeWeave.Interop.Async.Sample" />
    <InternalsVisibleTo Include="NativeWeave.Interop.Callbacks.Tests" />
    <InternalsVisibleTo Include="NativeWeave.Interop.Callbacks.Sample" />
  </ItemGroup>
</Project>
