<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>NativeWeave.Benchmarks.ManagedComparator</AssemblyName>
    <RootNamespace>NativeWeave.Reference.TaskService</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true'">$(MSBuildProjectDirectory)/packages.linux-x64.aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="[11.0.0]" />
    <PackageReference Include="SQLitePCLRaw.provider.sqlite3" Version="[3.0.5]" />
    <PackageReference Include="Npgsql" Version="[10.0.3]" />
    <!-- Only BCL application protocol/filesystem source is shared. There is no NativeWeave PackageReference. -->
    <Compile Include="../../../Reference.TaskService/Protocol.cs" Link="Shared/Protocol.cs" />
    <Compile Include="../../../Reference.TaskService/BlobStore.cs" Link="Shared/BlobStore.cs" />
    <EmbeddedResource Include="../../../Reference.TaskService/Migrations/*.sql" Link="Migrations/%(Filename)%(Extension)" />
    <None Include="$(ComparatorSqliteLibrary)" Link="libsqlite3.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(ComparatorSqliteLibrary)' != ''" />
  </ItemGroup>
</Project>
