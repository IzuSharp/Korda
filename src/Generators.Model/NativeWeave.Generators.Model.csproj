<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NativeWeave.Generators.Model</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NativeWeave.Generators.Model.Tests" />
    <InternalsVisibleTo Include="NativeWeave.Generators.Model.Sample" />
    <!-- Maintainer tools reuse the validated A09 model without widening its public API. -->
    <InternalsVisibleTo Include="NativeWeave.Generators.CSharp" />
    <InternalsVisibleTo Include="NativeWeave.Generators.Rust" />
  </ItemGroup>
</Project>
