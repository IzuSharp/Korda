<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>NativeWeave.Reference.TaskService</AssemblyName>
    <RootNamespace>NativeWeave.Reference.TaskService</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NativeWeavePackageVersion Condition="'$(NativeWeavePackageVersion)' == ''">0.1.0-preview.1</NativeWeavePackageVersion>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NativeWeave.Database.Sqlite" Version="$(NativeWeavePackageVersion)" />
    <PackageReference Include="NativeWeave.Database.PostgreSql" Version="$(NativeWeavePackageVersion)" />
    <PackageReference Include="NativeWeave.Server" Version="$(NativeWeavePackageVersion)" />
    <EmbeddedResource Include="Migrations/*.sql" />
  </ItemGroup>
</Project>
