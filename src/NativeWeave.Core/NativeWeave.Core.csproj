<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NativeWeave.Core</AssemblyName>
    <RootNamespace>NativeWeave.Interop</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Interop.Negotiation/**/*.cs;../Interop.Errors/**/*.cs" Exclude="../Interop.Negotiation/**/obj/**/*.cs;../Interop.Negotiation/**/bin/**/*.cs;../Interop.Errors/**/obj/**/*.cs;../Interop.Errors/**/bin/**/*.cs" />
    <ProjectReference Include="../Interop.Abi/Interop.Abi.csproj" />
    <InternalsVisibleTo Include="NativeWeave.Interop.Negotiation.Tests" />
    <InternalsVisibleTo Include="NativeWeave.Interop.Errors.Tests" />
    <InternalsVisibleTo Include="NativeWeave.Interop.Errors.Sample" />
  </ItemGroup>
</Project>
