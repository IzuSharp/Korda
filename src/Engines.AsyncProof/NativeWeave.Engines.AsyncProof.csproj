<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NativeWeave.Engines.AsyncProof</AssemblyName>
    <RootNamespace>NativeWeave.Engines.AsyncProof</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <PackageId>NativeWeave.Engines.AsyncProof</PackageId>
    <PackageVersion>0.1.0-proof.1</PackageVersion>
    <Description>Bounded Linux Hyper/Tokio HTTP service and Task/stream integration proof.</Description>
    <NativeAssetPath Condition="'$(NativeAssetPath)' == ''">$(MSBuildThisFileDirectory)../../target/release/libnativeweave_engine_asyncproof.so</NativeAssetPath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NativeWeave.Core/NativeWeave.Core.csproj" />
    <InternalsVisibleTo Include="NativeWeave.Engines.AsyncProof.Tests" />
    <None Include="$(NativeAssetPath)" Pack="true" PackagePath="runtimes/linux-x64/native/" Link="runtimes/linux-x64/native/libnativeweave_engine_asyncproof.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(IntermediateOutputPath)NativeWeave.nativeweave.engines.asyncproof.assets.json" Link="NativeWeave.nativeweave.engines.asyncproof.assets.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>
  <Target Name="ReadPrebuiltHttpIdentity" BeforeTargets="AssignTargetPaths">
    <Error Condition="!Exists('$(NativeAssetPath)')" Text="Maintainers must build the pinned async-proof asset first. Application consumers use precompiled NuGet assets." />
    <GetFileHash Files="$(NativeAssetPath)" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="_HttpNativeIdentity" /></GetFileHash>
    <PropertyGroup><_HttpHash>@(_HttpNativeIdentity->'%(FileHash)')</_HttpHash><_HttpLowerHash>$(_HttpHash.ToLowerInvariant())</_HttpLowerHash></PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)NativeWeave.nativeweave.engines.asyncproof.assets.json" Lines="{ &quot;schemaVersion&quot;: 1, &quot;engineId&quot;: &quot;nativeweave.engines.asyncproof&quot;, &quot;packageId&quot;: &quot;NativeWeave.Engines.AsyncProof&quot;, &quot;packageVersion&quot;: &quot;0.1.0-proof.1&quot;, &quot;rid&quot;: &quot;linux-x64&quot;, &quot;sourcePath&quot;: &quot;runtimes/linux-x64/native/libnativeweave_engine_asyncproof.so&quot;, &quot;outputPath&quot;: &quot;runtimes/linux-x64/native/libnativeweave_engine_asyncproof.so&quot;, &quot;sha256&quot;: &quot;$(_HttpLowerHash)&quot; }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(IntermediateOutputPath)http-native.sha256" Lines="%(_HttpNativeIdentity.FileHash)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><EmbeddedResource Include="$(IntermediateOutputPath)http-native.sha256" LogicalName="NativeWeave.Engines.AsyncProof.native-sha256" /></ItemGroup>
  </Target>
</Project>
