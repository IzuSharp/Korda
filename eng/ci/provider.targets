<Project>
  <ItemGroup>
    <KordaProviderBundle Include="@PROVIDER@" Shared="@SHARED@" />
  </ItemGroup>
  <PropertyGroup>
    <KordaSharedAssemblySet Condition="'$(KordaSharedAssemblySet)' == ''">@SHARED@</KordaSharedAssemblySet>
  </PropertyGroup>
  <Import Project="../tools/Korda.Packaging.targets" />
  <Import Project="../tools/Korda.Query.Generator.targets" Condition="'$(KordaProviderGeneratorImported)' != 'true'" />
  <PropertyGroup>
    <KordaProviderGeneratorImported>true</KordaProviderGeneratorImported>
  </PropertyGroup>
  <Target Name="KordaCheckProviderPair" BeforeTargets="KordaValidatePackageClosure">
    <Error Condition="'%(KordaProviderBundle.Shared)' != '$(KordaSharedAssemblySet)'"
           Text="These Korda providers contain different shared assemblies. Restore a compatible provider pair." />
    <Error Condition="'@(KordaProviderBundle->Count())' != '@(KordaClosure->Count())'"
           Text="Update both Korda providers to the standalone package format and remove direct references to historical component packages." />
  </Target>
</Project>
